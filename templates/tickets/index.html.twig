{% extends 'base.html.twig' %}

{% block body %}
    <h2>Liste tickets</h2>

    {% if tickets is empty %}
        <p>pas de ticket validé</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Catégorie</th>
                    <th>E-mail</th>
                    <th>Description</th>
                    <th>Date de création</th>
                </tr>
            </thead>
            <tbody>
                {% for ticket in tickets %}
                    <tr>
                        <td>{{ ticket.categorie }}</td>
                        <td>{{ ticket.mail }}</td>
                        <td>{{ ticket.description }}</td>
                        <td>{{ ticket.dateCreation|date('d/m/Y à H:i') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}

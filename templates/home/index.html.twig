{% extends 'base.html.twig' %}

{% block body %}
    <h2>ticket</h2>
    <p>introduction à définir</p>

    {% for message in app.flashes('success') %}
        <p>{{ message }}</p>
    {% endfor %}

    {{ form_start(ticketForm) }}
    {{ form_row(ticketForm.categorie) }}
    {{ form_row(ticketForm.mail) }}
    {{ form_row(ticketForm.description) }}
    {{ form_row(ticketForm.envoie) }}
    {{ form_end(ticketForm) }}
{% endblock %}

{% extends 'base.html.twig' %}
{% block title %}
    {{ titre }}
{% endblock %}
{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">
            {{ titre }}
        </h1>
        <a class="btn btn-dark" href="{{ path(routeNew) }}">
            Ajouter
        </a>
    </div>
    <div class="table-responsive">
        <table class="table bg-white shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>
                        Libellé
                    </th>
                    <th>
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>
                            {{ attribute(item, champ) }}
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-dark" href="{{ path(routeEdit, {id: item.id}) }}">
                                Modifier
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2" class="text-center">
                            Aucun élément.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

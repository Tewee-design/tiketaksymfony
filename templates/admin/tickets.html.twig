{% extends 'base.html.twig' %}
{% block title %}
    Gestion des tickets
{% endblock %}
{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">
            Gestion des tickets
        </h1>
        <a class="btn btn-dark" href="{{ path('app_admin_ticket_new') }}">
            Ajouter
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover bg-white shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>
                        N°
                    </th>
                    <th>
                        Client
                    </th>
                    <th>
                        Catégorie
                    </th>
                    <th>
                        État
                    </th>
                    <th>
                        Responsable
                    </th>
                    <th>
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for ticket in tickets %}
                    <tr>
                        <td>
                            #{{ ticket.id }}
                        </td>
                        <td>
                            {{ ticket.auteur }}
                        </td>
                        <td>
                            {{ ticket.categorie }}
                        </td>
                        <td>
                            {{ ticket.etat }}
                        </td>
                        <td>
                            {{ ticket.responsable ?: 'Non attribué' }}
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-dark" href="{{ path('app_admin_ticket_edit', {id: ticket.id}) }}">
                                Modifier
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center">
                            Aucun ticket.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
